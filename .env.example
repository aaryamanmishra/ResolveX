# ==============================================================================
# ResolveX AI — Environment Configuration Contract
# ==============================================================================
# In DEMO_MODE=true, the platform runs offline with zero external API keys.
# When connecting to live/external services, provide the flagged keys below.
# ==============================================================================

# Core System
ENVIRONMENT=development
DEBUG=true
DEMO_MODE=true
SECRET_KEY=resolvex-default-dev-secret-key-change-in-prod

# ------------------------------------------------------------------------------
# 1. DATABASE & QUEUE
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://resolvex:resolvex@localhost:5432/resolvex_db
VALKEY_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 2. PAYMENT PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Choose: "simulator" (default demo mode) or "razorpay" (test or live mode)
PAYMENT_PROVIDER=simulator

# [REQUIRED IF PAYMENT_PROVIDER=razorpay]
# Razorpay API Credentials (from Razorpay Dashboard -> Settings -> API Keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay Webhook Signing Secret (from Razorpay Dashboard -> Settings -> Webhooks)
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# 3. AI / MODEL PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Choose: "stub" (default demo mode), "gemma" (self-hosted), or "gemini" (managed)
MODEL_PROVIDER=stub

# [REQUIRED IF MODEL_PROVIDER=gemini]
# Google Gemini API Key (from Google AI Studio / GCP Console)
GEMINI_API_KEY=

# [REQUIRED IF MODEL_PROVIDER=gemma]
# DigitalOcean GPU Droplet / vLLM private endpoint URL and auth token
GEMMA_ENDPOINT_URL=
GEMMA_AUTH_TOKEN=

# ------------------------------------------------------------------------------
# 4. GRAPH ENGINE CONFIGURATION
# ------------------------------------------------------------------------------
# Choose: "memory" (default demo mode), "apache_age" (PostgreSQL extension), or "tigergraph"
GRAPH_ENGINE=memory

# [REQUIRED IF GRAPH_ENGINE=tigergraph]
# Optional TigerGraph Cloud connection details
TIGERGRAPH_HOST=
TIGERGRAPH_GRAPH_NAME=
TIGERGRAPH_SECRET=
TIGERGRAPH_TOKEN=

# ------------------------------------------------------------------------------
# 5. OBJECT STORAGE (EVIDENCE ASSETS)
# ------------------------------------------------------------------------------
# Local MinIO or DigitalOcean Spaces
SPACES_ENDPOINT=http://localhost:9000
SPACES_BUCKET=resolvex-evidence
# [REQUIRED FOR DIGITALOCEAN SPACES]
SPACES_ACCESS_KEY=
SPACES_SECRET_KEY=
